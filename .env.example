# Tokyo Mogu Mogu — environment template
#
# Quick start:
#   cp .env.example .env
# Then run `pnpm dev`. No variable is required today, so a fresh setup works
# with an empty `.env` (or no file at all).
#
# PUBLIC vs SECRET boundary
# -------------------------
# Every variable prefixed with `VITE_` is inlined into the client bundle by
# Vite and is VISIBLE to anyone who opens the app. Only put public values here.
#
# Server-only secrets (OAuth client secrets, API keys, database URLs, tokens)
# must NOT use the `VITE_` prefix and must never be imported in client code.
# This repo has no server today, so anything sensitive must stay out of the
# client entirely.

# --- Public (client-visible) ---

# Public Google OAuth client id, used by the #11 auth feature.
# Leave empty for the local demo — browsing the app does not require auth.
VITE_GOOGLE_CLIENT_ID=

# Base URL for future API calls. Leave empty to use the same origin.
VITE_API_BASE_URL=

# Map provider for the map feature. Default: 'leaflet'. Future options:
# 'mapbox' | 'google' | ...
VITE_MAP_PROVIDER=leaflet

# --- Server-only (never VITE_, never imported in client code) ---
# There are no server-only variables today. When one is added (e.g. an OAuth
# client secret), it MUST NOT use the VITE_ prefix and MUST NOT be imported in
# client code. Do not commit real `.env` files to the repository.
