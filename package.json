{
  "name": "tokyo-mogu-mogu",
  "private": true,
  "version": "0.1.0",
  "description": "Create reasons to discover outer Tokyo through regional food culture.",
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:related": "vitest related --run",
    "test:focused": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "data:sync": "tsx scripts/data-acquisition/sync.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:bundle",
    "review-packet": "tsx scripts/generate-review-packet.ts",
    "figma:check": "tsx scripts/figma-drift/check.ts",
    "figma:checkpoint": "tsx scripts/figma-drift/checkpoint.ts",
    "figma:gate": "tsx scripts/figma-drift/gate.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
